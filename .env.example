TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional override; otherwise TELEGRAM_CHANNEL_ID is used.
HERMES_TELEGRAM_CHAT_ID=
HERMES_DATA_DIR=data
HERMES_TIMEZONE=Asia/Qyzylorda
HERMES_INTERVAL_SECONDS=3600
HERMES_DOWNLOAD_MEDIA=1
HERMES_MAX_MEDIA_MB=30
# Optional semantic clustering requires requirements-embeddings.txt.
# The LLM still combines duplicate stories when this is disabled.
HERMES_EMBEDDINGS=0
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=glm-5.3-flash:cloud
OLLAMA_TIMEOUT=180
HERMES_STEP_TIMEOUT=900
